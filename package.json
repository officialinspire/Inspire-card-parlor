{
  "name": "inspire-card-parlor",
  "private": true,
  "version": "1.4.2",
  "description": "Five card games and The Thirteenth Hand: a 45-challenge Fredericksburg story with collectible decks, a credit shop, chapter music and offline play.",
  "type": "module",
  "author": "OFFICIAL INSPIRE (https://www.inspireclothing.art)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:release": "playwright test tests/e2e/assets.pages.spec.ts tests/e2e/pwa.spec.ts tests/e2e/offline-safety.spec.ts --project=github-pages --project=desktop --project=phone-portrait --workers=2",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e",
    "validate:decks": "tsx scripts/validate-decks.ts",
    "validate:story": "tsx scripts/validate-story-art.ts",
    "story:script": "tsx scripts/story/export-script.ts",
    "validate": "npm run validate:decks && npm run validate:story && npm run format:check",
    "art:cards": "python3 scripts/art/extract_cards.py",
    "art:story": "python3 scripts/art/story_assets.py",
    "art:images": "python3 scripts/art/build_images.py",
    "assets:placeholders": "tsx scripts/generate-placeholders.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "axe-core": "^4.10.3",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

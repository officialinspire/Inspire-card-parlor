{
  "name": "inspire-card-parlor",
  "private": true,
  "version": "0.7.0",
  "description": "INSPIRE CARD PARLOR \u2014 a cozy collection of classic playing-card games by OFFICIAL INSPIRE.",
  "type": "module",
  "author": "OFFICIAL INSPIRE (https://www.inspireclothing.art)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e",
    "validate:decks": "tsx scripts/validate-decks.ts",
    "validate": "npm run validate:decks && npm run format:check",
    "art:cards": "python3 scripts/art/extract_cards.py",
    "art:images": "python3 scripts/art/build_images.py",
    "assets:placeholders": "tsx scripts/generate-placeholders.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
